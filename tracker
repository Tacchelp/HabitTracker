#!/usr/bin/env bash

# Trouve le dossier du projet
PROJECT_DIR="$(dirname "$(realpath "$0")")"

# Se déplace dans le dossier du projet pour que data.json s'y enregistre
cd "$PROJECT_DIR" || exit

# Exécute Java (plus besoin de répéter $PROJECT_DIR car on y est déjà !)
java -cp "lib/*:bin" tracker.cli.Main "$@"
